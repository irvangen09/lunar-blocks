#: build/table/index.js:1
msgid "A plain table that scrolls sideways on small screens."
msgstr "Tabel biasa yang dapat digeser ke samping di layar kecil."

#: build/table/index.js:1
msgid "A table with a flat header. On small screens each row becomes a card. An image first column becomes the card image and the next column its title."
msgstr "Tabel dengan header datar. Di layar kecil setiap baris menjadi kartu. Kolom pertama yang berisi gambar menjadi gambar kartu, dan kolom berikutnya menjadi judulnya."

#: build/table/index.js:1
msgid "A grid of cards. An image first column becomes the card image and the next column its title. The other columns become rows."
msgstr "Kisi kartu. Kolom pertama yang berisi gambar menjadi gambar kartu, dan kolom berikutnya menjadi judulnya. Kolom lainnya menjadi baris."

#: build/table/index.js:1
msgid "A list of cards with a checklist. An image first column becomes the card image and the next column its name. The next two text columns become badges, and the first is split at commas. The rest become fields."
msgstr "Daftar kartu dengan daftar centang. Kolom pertama yang berisi gambar menjadi gambar kartu, dan kolom berikutnya menjadi namanya. Dua kolom teks berikutnya menjadi lencana, dan yang pertama dipecah di setiap koma. Sisanya menjadi isian."

#: build/table/index.js:1
msgid "A list of cards with a checklist. An image first column becomes the card image and the next column its name. The other columns become fields."
msgstr "Daftar kartu dengan daftar centang. Kolom pertama yang berisi gambar menjadi gambar kartu, dan kolom berikutnya menjadi namanya. Kolom lainnya menjadi isian."

#: build/table/index.js:1
msgid "Note in card header"
msgstr "Catatan di header kartu"

#: build/table/index.js:1
msgid "Shows the first column after the title as a small note, such as a level."
msgstr "Menampilkan kolom pertama setelah judul sebagai catatan kecil, misalnya tingkat."

