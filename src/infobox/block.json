{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lunar-blocks/infobox",
  "title": "Lunar Infobox",
  "category": "lunar-blocks",
  "description": "A summary box with an optional image and a list of label and value rows, such as a character, item, or place profile.",
  "keywords": [ "infobox", "facts", "summary", "profile" ],
  "textdomain": "lunar-blocks",
  "attributes": {
    "title": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": ".lunar-infobox__title"
    },
    "headingLevel": {
      "type": "string",
      "enum": [ "none", "h2", "h3", "h4", "h5", "h6" ],
      "default": "none"
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageUrl": {
      "type": "string",
      "source": "attribute",
      "selector": ".lunar-infobox__image",
      "attribute": "src",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "source": "attribute",
      "selector": ".lunar-infobox__image",
      "attribute": "alt",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [ "lunar-blocks-tokens", "dashicons", "file:./style-index.css" ]
}
