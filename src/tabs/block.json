{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lunar-blocks/tabs",
  "title": "Lunar Tabs",
  "category": "lunar-blocks",
  "description": "Organizes content into panels that visitors switch between with a row of tabs.",
  "keywords": [ "tabs", "tab", "panel" ],
  "textdomain": "lunar-blocks",
  "supports": {
    "html": false,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [ "lunar-blocks-tokens", "file:./style-index.css" ],
  "viewScript": "file:./view.js"
}
