{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lunar-blocks/accordion",
  "title": "Lunar Accordion",
  "category": "lunar-blocks",
  "description": "Groups content into sections that visitors can expand and collapse.",
  "keywords": [ "accordion", "toggle", "section", "faq" ],
  "textdomain": "lunar-blocks",
  "attributes": {
    "openOnDesktop": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [ "lunar-blocks-tokens", "file:./style-index.css" ],
  "viewScript": "file:./view.js"
}
