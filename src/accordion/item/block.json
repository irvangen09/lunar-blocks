{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lunar-blocks/accordion-item",
  "title": "Lunar Accordion Item",
  "category": "lunar-blocks",
  "description": "One section of an accordion: a title and free-form content.",
  "parent": [ "lunar-blocks/accordion" ],
  "textdomain": "lunar-blocks",
  "attributes": {
    "title": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": ".lunar-accordion-item__title"
    },
    "headingLevel": {
      "type": "string",
      "enum": [ "none", "h2", "h3", "h4", "h5", "h6" ],
      "default": "h3"
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "anchor": true
  }
}
