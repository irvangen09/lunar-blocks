{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lunar-blocks/info-list-item",
  "title": "Lunar Info List Item",
  "category": "lunar-blocks",
  "description": "One row of an info list: an optional icon, a label, and a value.",
  "parent": [ "lunar-blocks/info-list" ],
  "textdomain": "lunar-blocks",
  "attributes": {
    "icon": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": ".lunar-info-list-item__label-text"
    },
    "value": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": ".lunar-info-list-item__value"
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  }
}
