{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lunar-blocks/info-list-requirements",
  "title": "Lunar Info List Requirements",
  "category": "lunar-blocks",
  "description": "A titled checklist section of an info list, with an optional count of its items.",
  "parent": [ "lunar-blocks/info-list" ],
  "textdomain": "lunar-blocks",
  "attributes": {
    "title": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": ".lunar-info-list-requirements__title"
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "countText": {
      "type": "string",
      "source": "text",
      "selector": ".lunar-info-list-requirements__count",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  }
}
