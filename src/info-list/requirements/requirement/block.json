{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lunar-blocks/info-list-requirement",
  "title": "Lunar Info List Requirement",
  "category": "lunar-blocks",
  "description": "One item of an info list requirements section, with an icon marker that defaults to a check mark.",
  "parent": [ "lunar-blocks/info-list-requirements" ],
  "textdomain": "lunar-blocks",
  "attributes": {
    "icon": {
      "type": "string",
      "default": "dashicons-yes"
    },
    "text": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": ".lunar-info-list-requirement__text"
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  }
}
