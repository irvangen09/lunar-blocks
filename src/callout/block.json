{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lunar-blocks/callout",
  "title": "Lunar Callout",
  "category": "lunar-blocks",
  "description": "Highlights a note, tip, or warning within an article.",
  "keywords": [ "callout", "note", "tip", "warning" ],
  "textdomain": "lunar-blocks",
  "attributes": {
    "variant": {
      "type": "string",
      "enum": [ "info", "tips", "warning", "important" ],
      "default": "info"
    },
    "content": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": ".lunar-callout__text"
    },
    "label": {
      "type": "string",
      "source": "text",
      "selector": ".lunar-callout__label"
    },
    "variantName": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [ "lunar-blocks-tokens", "file:./style-index.css" ]
}
