{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lunar-blocks/gallery",
	"title": "Lunar Gallery",
	"category": "lunar-blocks",
	"description": "Displays a set of images in a grid, with a lightbox for viewing them larger.",
	"keywords": [ "gallery", "images", "grid", "lightbox" ],
	"textdomain": "lunar-blocks",
	"attributes": {
		"columns": {
			"type": "number",
			"default": 3
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css"
}