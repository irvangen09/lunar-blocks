{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lunar-blocks/gallery-item",
	"title": "Lunar Gallery Item",
	"category": "lunar-blocks",
	"description": "One image inside the Gallery, with an optional caption.",
	"keywords": [ "gallery item", "image", "caption" ],
	"textdomain": "lunar-blocks",
	"parent": [ "lunar-blocks/gallery" ],
	"attributes": {
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": "figcaption"
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	}
}